# LLM/search keys. Deterministic mode does not require keys.
# LLM mode requires DEEPSEEK_API_KEY and reads it only from .env.
DEEPRESEARCH_SEARCH_PROVIDER=fixture
DEEPRESEARCH_MODE=deterministic
DEEPSEEK_API_KEY=

# Required only when optional runtime semantic evaluation is enabled.
DASHSCOPE_API_KEY=
TAVILY_API_KEY=
DEEPRESEARCH_PDF_MAX_PAGES=100
LANGSMITH_API_KEY=
LANGSMITH_TRACING=false

# BEGIN GENERATED SETTINGS DEFAULTS
# Generated from deepresearch_agent.settings.Settings; do not edit by hand.
BRANCH_BUDGET_ENABLED=false
CONFIG_FAIL_FAST_ENABLED=true
CONTEXT_PACKER_ENABLED=false
CRITIC_ENABLED=true
DECISION_WEAVING_ENABLED=false
DYNAMIC_CAPABILITY_ENABLED=true
EXTRACTOR_ENABLED=true
INJECTION_GUARD_ENABLED=false
NUMERIC_CHECK_ENABLED=false
PRIOR_MEMORY_ENABLED=false
PROCEDURAL_MEMORY_ENABLED=false
PROGRESSIVE_DELIVERY_ENABLED=false
REFLECTION_ENABLED=false
RESEARCH_LOOP_ENABLED=false
RUN_MANIFEST_ENABLED=true
SEMANTIC_JUDGE_ENABLED=false
SKILL_PACKS_ENABLED=false
STRUCTURED_LOGGING_ENABLED=true
STRUCTURED_OUTPUT_ENABLED=true
TOOL_CONTRACT_ENABLED=true
TRAJECTORY_RECORD_ENABLED=false
DEEPRESEARCH_DYNAMIC_CAPABILITY_RULES_JSON={"financial_metric":["disclosure_source","structured_data_provider","web_fetch","web_search"],"market_price":["structured_data_provider","web_search"],"verify":["web_fetch","web_search"],"event":["web_fetch","web_search"],"narrative":["web_search"]}
# END GENERATED SETTINGS DEFAULTS

# Public demo deployment. Keep real values only in local/server .env.
DEPLOY_SSH_HOST=
DEPLOY_SSH_KEY_PATH=
DEPLOY_PUBLIC_HOST=
DEMO_OWNER_TOKEN=

# Local default. Docker mounts /app/data/runtime for this path.
DEEPRESEARCH_STORAGE_PATH=data/runtime/research.db
DEEPRESEARCH_MAX_CRITIC_ITER=3
DEEPRESEARCH_TOKEN_BUDGET=200000
DEEPRESEARCH_LLM_BUDGET_CNY=3.0
DEEPRESEARCH_LLM_LEDGER_PATH=data/runtime/llm_ledger.jsonl
DEEPRESEARCH_LLM_MAX_SUB_QUESTIONS=3
DEEPRESEARCH_LLM_MAX_QUERIES_PER_SUB_QUESTION=3
DEEPRESEARCH_BRANCH_TOTAL_BUDGET=20
DEEPRESEARCH_BRANCH_SINGLE_CAP=10
DEEPRESEARCH_RESEARCH_LOOP_MAX_ITERATIONS=1
DEEPRESEARCH_RESEARCH_LOOP_BUDGET_CEILING=20
DEEPRESEARCH_RESEARCH_LOOP_NO_PROGRESS_WINDOW=2
DEEPRESEARCH_RESEARCH_MIN_EVIDENCE_COUNT=2
DEEPRESEARCH_RESEARCH_MIN_INDEPENDENT_DOMAINS=2
DEEPRESEARCH_RESEARCH_MIN_AVERAGE_CONFIDENCE=0.7
DEEPRESEARCH_RESEARCH_MAX_FRESHNESS_AGE_DAYS=365
DEEPRESEARCH_RESEARCH_MAX_UNRESOLVED_CRITIC_ISSUES=0
DEEPRESEARCH_PRIOR_WATCH_CONFIDENCE_THRESHOLD=0.7
DEEPRESEARCH_DECISION_WEAVING_BUDGET_REMAINING_RATIO=0.2
DEEPRESEARCH_DECISION_WEAVING_VERIFY_MIN_ALLOCATION=1
DEEPRESEARCH_NUMERIC_CHECK_RELATIVE_TOLERANCE=0.01
DEEPRESEARCH_NUMERIC_CHECK_ABSOLUTE_TOLERANCE=0.01
DEEPRESEARCH_DEMO_DAILY_LLM_LIMIT_CNY=5.0
DEEPRESEARCH_DEMO_GUARD_PATH=data/runtime/demo_guard.json
DEEPRESEARCH_API_BASE_URL=http://localhost:8000
