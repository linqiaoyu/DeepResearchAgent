{
  "kinds": {
    "working": {
      "implementation": "ContextWorkingMemory",
      "lifecycles": {"in_memory": "run"},
      "scope_dimensions": ["namespace", "domain", "tenant_id", "research_id"],
      "provenance_fields": ["as_of", "provenance_refs"]
    },
    "episodic": {
      "implementation": "EpisodicMemory",
      "lifecycles": {"in_memory": "cross_run", "durable": "persistent"},
      "scope_dimensions": ["namespace", "domain", "tenant_id"],
      "provenance_fields": ["snapshot.as_of", "snapshot.manifest_ref"]
    },
    "semantic": {
      "implementation": "SemanticMemory",
      "lifecycles": {"in_memory": "cross_run"},
      "scope_dimensions": ["namespace", "domain", "tenant_id"],
      "provenance_fields": ["as_of", "source_urls"]
    },
    "procedural": {
      "implementation": "ProceduralMemory",
      "lifecycles": {"in_memory": "cross_run", "durable": "persistent"},
      "scope_dimensions": ["namespace", "domain", "tenant_id"],
      "provenance_fields": ["observed_as_of", "provenance_refs", "run_id"]
    }
  }
}
